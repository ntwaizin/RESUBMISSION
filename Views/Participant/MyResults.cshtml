@model List<RaceDay.Web.Models.ResultDto>
@{ ViewData["Title"] = "My Results"; }
<div class="rd-hero"><h1>My Results</h1><p>Your race history across completed events.</p></div>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
@if (!Model.Any()) { <div class="alert alert-info">No results have been recorded for you yet. Results appear once an organiser publishes them.</div> }
else
{
    <div class="card"><div class="card-body table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><strong>@r.EventName</strong></td><td>@(r.EventDate?.ToString("dd MMM yyyy"))</td><td>@r.CategoryName</td>
                <td class="display-font fs-5">@r.FinishTime</td>
                <td><span class="badge type-badge fs-6">@r.Position@(r.TotalFinishers > 0 ? " of " + r.TotalFinishers : "")</span></td>
            </tr>
        }
        </tbody></table></div></div>
}
