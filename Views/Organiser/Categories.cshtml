@model RaceDay.Web.Models.CategoriesPageModel
@{ ViewData["Title"] = "Categories"; }
<div class="rd-hero"><h2>Categories</h2><p>@Model.Event.Name &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p></div>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
<div class="row g-4">
    <div class="col-lg-5"><div class="card card-accent"><div class="card-body">
        <h3>Add Category</h3>
        <form asp-action="AddCategory" asp-route-id="@Model.Event.EventID" method="post">
            <div class="mb-3"><label class="form-label" for="name">Name</label><input id="name" name="name" class="form-control" maxlength="80" placeholder="e.g. Under 20, Senior, 10km" required /></div>
            <div class="mb-3"><label class="form-label" for="description">Description (optional)</label><input id="description" name="description" class="form-control" maxlength="200" /></div>
            <button class="btn btn-primary" type="submit">Add Category</button>
        </form>
    </div></div></div>
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <h3>Current Categories</h3>
        @if (!Model.Categories.Any()) { <p class="text-muted mb-0">No categories yet.</p> }
        else
        {
            <table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Description</th><th></th></tr></thead><tbody>
            @foreach (var c in Model.Categories)
            {
                <tr><td><strong>@c.Name</strong></td><td>@c.Description</td>
                <td class="text-end"><form asp-action="DeleteCategory" asp-route-id="@Model.Event.EventID" asp-route-categoryId="@c.CategoryID" method="post" onsubmit="return confirm('Remove this category?');"><button class="btn btn-sm btn-danger" type="submit">Remove</button></form></td></tr>
            }
            </tbody></table>
        }
    </div></div></div>
</div>
<a class="btn btn-outline-secondary mt-3" asp-action="Events">&larr; Back to events</a>
