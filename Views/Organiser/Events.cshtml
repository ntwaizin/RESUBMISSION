@model List<RaceDay.Web.Models.EventDto>
@{ ViewData["Title"] = "Manage Events"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Manage Events</h1>
    <a class="btn btn-primary" asp-action="CreateEvent">+ New Event</a>
</div>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
@if (!Model.Any())
{
    <div class="alert alert-info">No events yet. Create your first event.</div>
}
else
{
    <div class="card"><div class="card-body table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Type</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><strong>@e.Name</strong></td>
                <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                <td>@e.Location</td>
                <td>@e.Distance.ToString("0.##") km</td>
                <td><span class="badge type-badge">@e.EventType</span></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-id="@e.EventID">Categories</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Results" asp-route-id="@e.EventID">Results</a>
                    <a class="btn btn-sm btn-primary" asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a>
                    <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this event? This cannot be undone.');">
                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
