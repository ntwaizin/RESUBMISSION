@model RaceDay.Web.Models.EventFormModel
@{
    var editing = Model.EventID > 0;
    ViewData["Title"] = editing ? "Edit Event" : "Create Event";
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card card-accent"><div class="card-body p-4">
    <h2>@ViewData["Title"]</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@(editing ? Model.EventID : (int?)null)" method="post" enctype="multipart/form-data" novalidate>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label">Date &amp; time</label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Distance" class="form-label">Distance (km)</label><input asp-for="Distance" type="number" step="0.1" class="form-control" /><span asp-validation-for="Distance" class="text-danger"></span></div>
            <div class="col-md-6 mb-3">
                <label asp-for="EventType" class="form-label">Event type</label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option><option value="Walk">Walk</option><option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Banner" class="form-label">Event banner image</label>
            @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
            {
                <div class="mb-2"><img src="@Model.BannerUrl" alt="Current banner" class="img-fluid rounded" style="max-height:140px" /></div>
            }
            <input asp-for="Banner" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="Banner" class="text-danger"></span>
            <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB. Stored in Azure Blob Storage via the API.</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">@(editing ? "Save Changes" : "Create Event")</button>
            <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
        </div>
    </form>
</div></div></div></div>
